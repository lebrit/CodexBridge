<Project>
  <PropertyGroup>
    <VersionPrefix>0.3.1</VersionPrefix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)</Version>
    <Company>CodexBridge Contributors</Company>
    <Product>CodexBridge</Product>
    <Description>Windows backup and recovery assistant for development environments.</Description>
    <RepositoryUrl>https://github.com/lebrit/CodexBridge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
