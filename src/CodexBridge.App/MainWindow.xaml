<Window x:Class="CodexBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexBridge" Height="780" Width="1220" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="MainContent" Grid.Column="0" Margin="30,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock x:Name="PageTitle" Text="Обзор" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageSubtitle" Text="Состояние резервного копирования и быстрые действия"
                           Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0"/>
            </StackPanel>

            <TabControl x:Name="ContentTabs" Grid.Row="1" SelectedIndex="0" Style="{StaticResource ContentOnlyTabs}">
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="ProtectionStatusCard" Style="{StaticResource PanelCard}" BorderThickness="2"
                                    Margin="0,0,0,16" AutomationProperties.Name="Общее состояние защиты">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="StatusIcon" Width="54" Height="54" CornerRadius="27"
                                            VerticalAlignment="Top" Margin="0,0,16,0">
                                        <TextBlock x:Name="StatusSymbol" Text="!" Foreground="White" FontSize="25" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="СОСТОЯНИЕ ЗАЩИТЫ" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="ReadinessText" Text="Проверяем настройки…" FontSize="24" FontWeight="SemiBold"
                                                   Margin="0,5,12,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="StatusDescriptionText" Text="CodexBridge проверяет хранилище и проекты."
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,5,16,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AutomationStatusText" Text="Автокопирование: проверяется"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,9,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="PrimaryActionButton" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                            Content="Открыть настройку" VerticalAlignment="Center" Margin="8,0,0,0"
                                            Click="PrimaryActionButton_Click" AutomationProperties.Name="Рекомендуемое действие"/>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource StatusCard}">
                                    <StackPanel>
                                        <TextBlock Text="ПРОЕКТЫ" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="ProjectCountText" Text="0 защищено" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="ProjectDetailsText" Text="Проекты ещё не найдены" Foreground="{DynamicResource TextMuted}"
                                                   FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource StatusCard}">
                                    <StackPanel>
                                        <TextBlock Text="ЛОКАЛЬНАЯ КОПИЯ" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="LastBackupText" Text="Ещё не создавалась" FontSize="20" FontWeight="SemiBold"
                                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="LocalBackupDetailsText" Text="Зашифрованное хранилище"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource StatusCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="ОБЛАЧНАЯ КОПИЯ" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="CloudBackupText" Text="Выключена" FontSize="20" FontWeight="SemiBold"
                                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="CloudBackupDetailsText" Text="Можно включить в настройках"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Быстрые действия" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <WrapPanel>
                                        <Button Content="Найти проекты" Click="RefreshProjects_Click"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Создать копию сейчас" Click="BackupNow_Click"/>
                                        <Button Content="Проверить хранилище" Click="CheckRepository_Click"/>
                                        <Button Content="Глубокая проверка 5%" Click="DeepCheckRepository_Click"/>
                                        <Button Content="Включить автобэкап" Click="InstallScheduler_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14" AutomationProperties.Name="Последние операции">
                                <StackPanel>
                                    <TextBlock Text="Последние операции" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="LastMessageText" Text="История появится после первой операции."
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding RecentActivities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1" CornerRadius="9" Padding="14">
                                <TextBlock Text="Ключ восстановления защищён Windows DPAPI. Сохраните отдельную копию ключа в менеджере паролей или на внешнем носителе."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Style="{StaticResource PrimaryButton}" Content="Сканировать" Click="RefreshProjects_Click"/>
                            <Button Content="Сохранить выбор" Click="SaveProjects_Click"/>
                        </WrapPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Projects}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="False" SelectionMode="Single" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Защищать" Binding="{Binding IsProtected, Mode=TwoWay}" Width="90"/>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" IsReadOnly="True" Width="180"/>
                                <DataGridTextColumn Header="Путь" Binding="{Binding Path}" IsReadOnly="True" Width="*"/>
                                <DataGridCheckBoxColumn Header="Git" Binding="{Binding IsGit}" IsReadOnly="True" Width="60"/>
                                <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" IsReadOnly="True" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource PanelCard}" MaxWidth="860" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Источник" FontWeight="SemiBold"/>
                                <WrapPanel Margin="0,8,0,14">
                                    <RadioButton x:Name="LocalSourceRadio" GroupName="RestoreSource" Style="{StaticResource NavItem}"
                                                 Content="Локальное хранилище" IsChecked="True" Width="220" Margin="0,0,8,0"/>
                                    <RadioButton x:Name="CloudSourceRadio" GroupName="RestoreSource" Style="{StaticResource NavItem}"
                                                 Content="Облачное хранилище" Width="220" Margin="0"/>
                                </WrapPanel>
                                <Button Content="Загрузить список снимков" HorizontalAlignment="Left" Click="LoadSnapshots_Click"/>
                                <ListBox x:Name="SnapshotsList" ItemsSource="{Binding Snapshots}" DisplayMemberPath="Display" Height="180" Margin="0,5,0,14"/>
                                <TextBlock Text="Единая папка проектов" FontWeight="SemiBold"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Выбрать…" Click="ChooseDestination_Click"/>
                                    <TextBox x:Name="DestinationText"/>
                                </DockPanel>
                                <TextBlock Text="Существующие отличающиеся файлы не перезаписываются: новая версия попадёт в .codexbridge-conflicts."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,14"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Восстановить выбранный снимок"
                                        HorizontalAlignment="Left" Click="Restore_Click"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <StackPanel MaxWidth="840" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Перенос приложений" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="CodexBridge сохраняет WinGet-манифест. Пароли, лицензии и учётные данные не копируются."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,18"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Обновить список программ" Click="CaptureApps_Click"/>
                                    <Button Content="Установить после восстановления" Click="InstallApps_Click"/>
                                </WrapPanel>
                                <TextBlock Text="Недоступные в WinGet программы будут пропущены."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="VsCodeCard" Style="{StaticResource PanelCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="VS Code обнаружен" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox x:Name="VsCodeIncludeCheck" Content="Сохранять настройки и список расширений VS Code" Margin="0,0,0,8"/>
                                <TextBlock Text="После восстановления расширения можно установить той же кнопкой вместе с приложениями."
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                            <GroupBox Header="Корни проектов">
                                <StackPanel>
                                    <ListBox x:Name="RootsList" ItemsSource="{Binding Roots}" Height="120"/>
                                    <TextBlock Text="Поиск выполняется только в этих папках, а не по всему компьютеру. Новые проекты будут найдены перед резервным копированием."
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Добавить папку" Click="AddRoot_Click"/>
                                        <Button Content="Убрать из списка" Click="RemoveRoot_Click"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Найти проекты сейчас" Click="RefreshProjects_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Локальная зашифрованная копия">
                                <StackPanel>
                                    <TextBlock Text="Путь репозитория"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Выбрать…" Click="ChooseLocalRepository_Click"/>
                                        <TextBox x:Name="LocalRepositoryText"/>
                                    </DockPanel>
                                    <TextBlock Text="Ключ восстановления"/>
                                    <PasswordBox x:Name="PasswordInput"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Сохранить настройки" Click="SaveSettings_Click"/>
                                        <Button Content="Создать/подключить хранилище" Click="InitializeLocal_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Облачная копия">
                                <StackPanel>
                                    <CheckBox x:Name="CloudEnabledCheck" Content="Включить облачный бэкап после локального" Margin="0,0,0,10"/>
                                    <TextBlock Text="Имя rclone remote"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Подставить адрес" Click="UseRcloneRemote_Click"/>
                                        <TextBox x:Name="RcloneRemoteNameText"/>
                                    </DockPanel>
                                    <WrapPanel>
                                        <Button Content="Открыть мастер rclone" Click="ConfigureRclone_Click"/>
                                        <Button Content="Найти настроенные remotes" Click="DetectRcloneRemotes_Click"/>
                                    </WrapPanel>
                                    <TextBlock Text="Restic/rclone адрес, например rclone:my-remote:CodexBridge/restic-v1"/>
                                    <TextBox x:Name="CloudRepositoryText"/>
                                    <Button Content="Создать/подключить облачное хранилище" HorizontalAlignment="Left" Click="InitializeCloud_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Хранение снимков">
                                <StackPanel>
                                    <CheckBox x:Name="RetentionEnabledCheck" Content="Автоматически удалять лишние старые снимки после успешного backup" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <TextBlock Text="Дней" VerticalAlignment="Center" Margin="0,0,6,8"/>
                                        <TextBox x:Name="KeepDailyText" Width="55"/>
                                        <TextBlock Text="Недель" VerticalAlignment="Center" Margin="12,0,6,8"/>
                                        <TextBox x:Name="KeepWeeklyText" Width="55"/>
                                        <TextBlock Text="Месяцев" VerticalAlignment="Center" Margin="12,0,6,8"/>
                                        <TextBox x:Name="KeepMonthlyText" Width="55"/>
                                    </WrapPanel>
                                    <TextBlock Text="По умолчанию функция выключена. При включении restic оставляет 7 дневных, 4 недельных и 6 месячных снимков."
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Автоматизация">
                                <WrapPanel>
                                    <Button Content="Установить restic и rclone" Click="InstallTools_Click"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Включить ежечасный бэкап" Click="InstallScheduler_Click"/>
                                    <Button Content="Отключить автобэкап" Click="RemoveScheduler_Click"/>
                                </WrapPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </TabItem>
            </TabControl>

        </Grid>

        <Border x:Name="Sidebar" Grid.Column="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1,0,0,0" Padding="20,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="6,0,6,28">
                    <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource Primary}" HorizontalAlignment="Left">
                        <TextBlock Text="CB" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CodexBridge" FontSize="23" FontWeight="SemiBold" Margin="0,13,0,3"/>
                    <TextBlock Text="Ваши проекты под защитой" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="OverviewNav" GroupName="Navigation" Style="{StaticResource NavItem}" Content="Обзор" Tag="0" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="ProjectsNav" GroupName="Navigation" Style="{StaticResource NavItem}" Content="Проекты" Tag="1" Checked="Nav_Checked"/>
                    <RadioButton x:Name="RestoreNav" GroupName="Navigation" Style="{StaticResource NavItem}" Content="Восстановление" Tag="2" Checked="Nav_Checked"/>
                    <RadioButton x:Name="ProgramsNav" GroupName="Navigation" Style="{StaticResource NavItem}" Content="Программы" Tag="3" Checked="Nav_Checked"/>
                    <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavItem}" Content="Настройки" Tag="4" Checked="Nav_Checked"/>
                    <RadioButton x:Name="LogNav" GroupName="Navigation" Style="{StaticResource NavItem}" Content="Журнал" Tag="5" Checked="Nav_Checked"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource PrimaryButton}" Content="Мастер настройки" Click="OpenWizard_Click" Margin="0,0,0,8"/>
                    <Button x:Name="ThemeButton" Content="Светлая тема" Click="ToggleTheme_Click" Margin="0,0,0,12"/>
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="BusyPanel" Grid.ColumnSpan="2" Panel.ZIndex="10" Visibility="Collapsed"
                VerticalAlignment="Bottom" Margin="30,0,278,20" Padding="16,12"
                Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Primary}"
                BorderThickness="1" CornerRadius="10" AutomationProperties.LiveSetting="Polite">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="BusyText" Text="Выполняется операция…" FontWeight="SemiBold"/>
                <ProgressBar x:Name="BusyProgress" Grid.Row="1" Height="4" Margin="0,9,0,0" IsIndeterminate="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
