<Window x:Class="CodexBridge.App.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мастер настройки CodexBridge" Width="780" Height="590" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="Первичная настройка" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock x:Name="StepText" Text="Шаг 1 из 3" Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelCard}">
            <Grid>
                <ScrollViewer x:Name="WelcomePage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Добро пожаловать в CodexBridge" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <TextBlock x:Name="WizardIntroText" Text="Мастер подготовит приложение так, чтобы новые проекты и восстановленная среда находились в одном понятном месте."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="15" Margin="0,0,0,22"/>
                    <TextBlock Text="Что вы хотите сделать?" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <StackPanel Margin="0,0,0,20">
                        <RadioButton x:Name="NewSetupModeRadio" GroupName="SetupMode" IsChecked="True"
                                     Content="Настроить резервное копирование на этом компьютере"
                                     Checked="SetupMode_Changed" Margin="0,4"
                                     AutomationProperties.Name="Настроить новый резервный архив"/>
                        <RadioButton x:Name="NewComputerModeRadio" GroupName="SetupMode"
                                     Content="Восстановить всё на новом компьютере"
                                     Checked="SetupMode_Changed" Margin="0,4"
                                     AutomationProperties.Name="Режим восстановления на новом компьютере"/>
                    </StackPanel>
                    <TextBlock Text="Что будет настроено" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="WizardPlanText"
                               Text="• единая папка проектов&#x0a;• локальное зашифрованное хранилище&#x0a;• ключ восстановления, защищённый Windows DPAPI&#x0a;• при желании — вторая копия через rclone в вашем облаке"
                               TextWrapping="Wrap" LineHeight="26"/>
                    <TextBlock Text="CodexBridge не отправляет список ваших проектов разработчику и не публикует пользовательские данные в GitHub."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,22,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="ProjectsPage" Visibility="Collapsed">
                    <TextBlock Text="Единая папка проектов" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Новые и восстановленные проекты будут собраны здесь. Текущие папки останутся на месте, пока вы сами их не перенесёте."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,20"/>
                    <TextBlock Text="Папка проектов" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,4,0,12">
                        <Button DockPanel.Dock="Right" Content="Выбрать…" Click="BrowseProjectRoot_Click"/>
                        <TextBox x:Name="ProjectRootText" AutomationProperties.Name="Единая папка проектов"/>
                    </DockPanel>
                    <TextBlock Text="Эта папка станет основной и для восстановления на новом компьютере. Существующие корни CodexBridge не удалит."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>

                <ScrollViewer x:Name="BackupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="BackupPageTitle" Text="Защита резервной копии" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="LocalRepositoryLabel" Text="Локальное хранилище" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,4,0,10">
                            <Button DockPanel.Dock="Right" Content="Выбрать…" Click="BrowseRepository_Click"
                                    AutomationProperties.Name="Выбрать локальное хранилище"/>
                            <TextBox x:Name="LocalRepositoryText" AutomationProperties.Name="Путь локального хранилища"/>
                        </DockPanel>

                        <TextBlock x:Name="RecoveryKeyLabel" Text="Ключ восстановления" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,4,0,6">
                            <Button x:Name="GenerateKeyButton" DockPanel.Dock="Right" Content="Создать новый" Click="GenerateKey_Click"/>
                            <TextBox x:Name="RecoveryKeyText" FontFamily="Consolas"
                                     AutomationProperties.Name="Ключ восстановления"/>
                        </DockPanel>
                        <Button Content="Скопировать ключ" HorizontalAlignment="Left" Click="CopyKey_Click"/>
                        <TextBlock x:Name="RecoveryKeyHelp" Text="Сохраните ключ отдельно. Без него резервную копию нельзя восстановить на другом компьютере."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>

                        <CheckBox x:Name="CloudEnabledCheck" Content="Добавить вторую копию в моё облако" Margin="0,0,0,8"/>
                        <TextBlock x:Name="CloudRepositoryLabel" Text="Адрес restic/rclone (можно заполнить позже)"/>
                        <TextBox x:Name="CloudRepositoryText" AutomationProperties.Name="Адрес облачного хранилища"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="_Пропустить" Click="Skip_Click" AutomationProperties.Name="Пропустить мастер настройки"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="_Назад" Click="Back_Click" Visibility="Hidden"
                        AutomationProperties.Name="Предыдущий шаг мастера"/>
                <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Content="_Далее" Click="Next_Click"
                        Margin="0,0,0,8" IsDefault="True" AutomationProperties.Name="Следующий шаг мастера"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
